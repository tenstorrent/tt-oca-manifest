# clangd configuration.
#
# Only the OCA validator tree under validators/oca/ has C sources;
# the rest of the repo is Python. clangd needs a few hints for the OCA
# tree because no compile_commands.json is generated for it.

If:
  PathMatch: validators/oca/.*\.(c|h)$
CompileFlags:
  Add:
    - -xc
    - -std=c99
    - -Wall
    - -Wextra
    - -pedantic
    - -Ivalidators/oca/lib
    - -Ivalidators/oca/test
  Compiler: clang
